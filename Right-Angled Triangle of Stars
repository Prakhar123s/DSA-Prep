Example 1:
Input: n = 4

Output: ["*","**","***","****"]

Example 2:
Input: n = 3

Output: ["*","**","***"]


class Solution {
    public List<String> rightAngledTriangle(int n) {

        List<String> lst=new ArrayList<>();

        String str="";
        for(int i=0;i<n;i++){

            for(int j=i;j<=i;j++){

                str=str+"*";
            }
            lst.add(str);
        }
        return lst;
    }
}
