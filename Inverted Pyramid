Example 1:
Input: n = 3

Output: ["*****"," ***","  *"]

Example 2:
Input: n = 4

Output: ["*******"," *****","  ***","   *"]



class Solution {
    public List<String> invertedPyramid(int n) {
        

        List<String> lst=new ArrayList<>();

        for(int i=n;i>0;i--){

            String str="";

            for(int j=n-i;j>0;j--){

                str=str+" ";
            }
            for(int k=2*i-1;k>0;k--){
                str=str+"*";
            }
            lst.add(str);
        }
        return lst;
    }
}
