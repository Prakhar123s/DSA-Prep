Example 1:
Input: n = 3

Output: ["  *"," ***","*****"]

Example 2:
Input: n = 4

Output: ["   *","  ***"," *****","*******"]



class Solution {
    public List<String> pyramidOfStars(int n) {
        
        List<String> lst = new ArrayList<>();

        for (int i = 1; i <=n; i++) {
        String str="";

            for (int j = 0; j< n - i ; j++) {

                str = str + " ";
            }
            for(int k=0;k<(2*i-1);k++){
                str=str+"*";
            }
            lst.add(str);
        }
        return lst;
    }
}
